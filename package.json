{
  "name": "curriculos",
  "version": "0.1.0",
  "private": true,
  "description": "Maximizador de entrevistas com restrição de veracidade — busca vagas, gera kits de aplicação ATS e rastreia o funil",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "tsx src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "ui": "tsx src/server/index.ts",
    "pretest": "rm -rf .test-sandbox && mkdir -p .test-sandbox && cp -R tests/fixtures/sandbox-root/. .test-sandbox/",
    "test": "CURRICULOS_ROOT=\"$PWD/.test-sandbox\" node --import tsx --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:watch": "CURRICULOS_ROOT=\"$PWD/.test-sandbox\" node --import tsx --test --watch --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:precheck": "node --import tsx -e \"import('./src/render/pdf.ts').then(m=>{m.findChrome();console.log('chrome ok')})\"",
    "onda0": "npm run typecheck && npm run test:precheck && npm test",
    "ui:on": "tsx src/cli/ui-service.ts on",
    "ui:off": "tsx src/cli/ui-service.ts off",
    "ui:status": "tsx src/cli/ui-service.ts status"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "marked": "^18.0.6",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.61.1",
    "puppeteer-core": "^25.3.0",
    "ulid": "^3.0.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "unpdf": "^1.8.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
